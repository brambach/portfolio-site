{
  "buildCommand": "npm run build",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/lab/e/projects/:id(dervo|arro|lucid|integration-portal|agentsky)",
      "destination": "/projects/:id",
      "permanent": false
    },
    {
      "source": "/lab",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/lab/:path*",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/projects",
      "destination": "/index.html"
    },
    {
      "source": "/projects/:id(dervo|arro|lucid|integration-portal|agentsky|easeprint|dryline|comehome)",
      "destination": "/projects/:id.html"
    },
    {
      "source": "/work",
      "destination": "/index.html"
    },
    {
      "source": "/drive",
      "destination": "/index.html"
    },
    {
      "source": "/next",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    }
  ]
}
